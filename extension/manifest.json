{
  "manifest_version": 3,
  "name": "Flash Creator",
  "short_name": "Flash Creator",
  "version": "0.3.3",
  "description": "Prepara en tu equipo una cola local de videos y su agenda para TikTok Studio.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Abrir Flash Creator"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["transfer/bridge.html", "transfer/bridge.js"],
      "matches": ["https://www.tiktok.com/*"]
    }
  ]
}
